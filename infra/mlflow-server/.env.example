# Only relevant if you move the MLflow server off the docker-compose dev
# defaults and onto a real VPS/persistent host. Not read by docker-compose.yml
# in this directory as-is (that file uses inline dev credentials) -- this is
# the pattern to switch to before exposing the server beyond a quick tunnel.

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too

# Set as a Kaggle Secret in the training notebook, not committed anywhere:
# MLFLOW_TRACKING_URI=https://<your-tunnel-or-vps>.example.com
