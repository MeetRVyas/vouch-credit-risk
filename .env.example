# Copy to .env for local (non-docker) development: `uvicorn credit_risk.api.main:app --reload`
# reads this automatically via pydantic-settings.

APP_ENV=development

# Directory containing model.json + metadata.json (see
# credit_risk.models.artifact.ModelArtifact). Populated by
# scripts/train_local_demo.py for a quick local model, or by the real
# training notebook's output.
MODEL_ARTIFACT_DIR=artifacts/model

# Prediction-logging Postgres (separate from MLflow's tracking DB -- see
# infra/mlflow-server/). Local dev default matches infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/credit_risk
LOG_PREDICTIONS=true

# Risk-band thresholds -- placeholders until calibrated against the real
# training run's approval_cutoff_table (see evaluation/metrics.py).
RISK_BAND_LOW_MAX=0.10
RISK_BAND_MEDIUM_MAX=0.30

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

DEVICE = "cuda"